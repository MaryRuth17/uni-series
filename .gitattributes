# Normalize line endings so Windows and CI/worktree checkouts produce identical files.
* text=auto eol=lf

# Binary assets.
*.png binary
*.jpg binary
*.webp binary
*.ogg binary
*.m4a binary
*.wav binary
*.mp3 binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.aseprite binary
*.ase binary
